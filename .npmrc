# Supply-chain cooldown (npm 11.10+). Rejects package versions published fewer than
# this many days ago so a compromised publish can be yanked before we resolve it
# (most malicious versions are taken down the same day; two days is the buffer).
# Unit is days (a Number). `2d` is not valid here.
#
# `npm install pkg` without a version picks the newest eligible release. An exact
# version that is too new errors. `npm audit fix` also honors this: if the only
# fix is too new, npm keeps the vulnerable version, warns, and exits non-zero —
# add that package to `min-release-age-exclude` only for a known emergency patch.
#
# npm < 11.10 silently ignores this key. Node 24 (`.nvmrc`) ships npm ≥ 11.16;
# the Node 22 CI job does not enforce it. Do not pass `--min-release-age=0` to
# "just get latest" — that is how a fresh malicious version gets into the lockfile.
min-release-age=2

# Resolve Casadega's private shared development tooling from GitHub Packages.
# Authentication stays outside the repository: local developers configure their
# user-level npm settings, while GitHub Actions maps CASADEGA_PACKAGES_TOKEN to
# NODE_AUTH_TOKEN only for dependency-install steps.
@casadega-development:registry=https://npm.pkg.github.com
