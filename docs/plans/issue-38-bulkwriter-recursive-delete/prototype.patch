+  | {
+      index: number;
+      id: ID;
+      op: BulkWriteOperationKind;
+      ok: true;
+      writeTime: FirebaseFirestore.Timestamp;
+    }
+  | {
+      index: number;
+      id: ID;
+      op: BulkWriteOperationKind;
+      ok: false;
