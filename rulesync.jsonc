{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",

  // Single source of truth for AI agent instruction files lives in `.rulesync/rules/*.md`.
  // Edit those, then run `npm run rules:sync` to regenerate the tool-native files below.
  // `npm run rules:check` (rulesync generate --check) fails if the generated files are stale;
  // it runs in the pre-push hook and CI. Generated outputs are prettier-ignored and must not be
  // hand-edited.
  //
  // rulesync docs (frontmatter fields, per-tool overrides, file formats, all options):
  // https://github.com/dyoshikawa/rulesync — see "Each File Format" and the configuration sections.
  //
  // Features (all authored under .rulesync/): rules, commands, skills, hooks.
  //
  // Generated per target (prettier-ignored, do not hand-edit):
  //   cursor     -> .cursor/rules/*.mdc, .cursor/commands/*.md, .cursor/skills/*/SKILL.md
  //   claudecode -> CLAUDE.md (root), .claude/rules/*.md, .claude/commands/*.md,
  //                 .claude/skills/*/SKILL.md
  //   agentsmd   -> AGENTS.md (root) + .agents/memories/*.md + .agents/skills/*/SKILL.md
  //   codexcli   -> AGENTS.md family (Codex reads AGENTS.md/.agents/*; same output as agentsmd here)
  //
  // Notes:
  // - Root project memory is generated to BOTH `AGENTS.md` and `CLAUDE.md` as real files (the root
  //   rule targets agentsmd/codexcli/claudecode). `CLAUDE.md` used to be a committed symlink to
  //   `AGENTS.md`; that double-loaded every rule for Claude Code, because `AGENTS.md` inlines the
  //   non-root rule bodies (see the target-order note below) while Claude Code separately reads
  //   `.claude/rules/`. Generating it removes the duplication and the Windows symlink hazard.
  //   rulesync logs a benign "No root rulesync rule file found for target 'cursor'" note, because
  //   the root rule deliberately does not target Cursor — Cursor reads `AGENTS.md` natively.
  // - TARGET ORDER MATTERS: `agentsmd` and `codexcli` both write `AGENTS.md` and the last one wins,
  //   but they emit DIFFERENT formats. With `codexcli` last (as below) `AGENTS.md` INLINES every
  //   non-root rule body — right for this repo, where the whole rule set is small and Codex/Cursor
  //   should always carry it. Putting `agentsmd` last instead emits only a TOON reference table
  //   pointing at `.agents/memories/`. Nothing warns you; do not reorder these casually.
  // - Commands are emitted for Cursor + Claude; the AGENTS.md/Codex family does not get project-mode
  //   commands (Codex commands are global-mode only), so they are intentionally absent there.
  "targets": ["cursor", "claudecode", "agentsmd", "codexcli"],
  "features": ["rules", "commands", "skills", "hooks"],

  // Cross-repository quality policy is distributed with the same exact package
  // release as its executable implementation. RuleSync verifies the package
  // integrity and selected files through rulesync-npm.lock.json. FlintFire's
  // application-specific rules and skills remain authored locally.
  "sources": [
    {
      "source": "@casadega-development/ts-repo-tooling",
      "transport": "npm",
      "registry": "https://npm.pkg.github.com",
      "ref": "0.6.0",
      "tokenEnv": "NODE_AUTH_TOKEN",
      "rules": ["sonarqube-safety", "test-falsification"],
    },
  ],
}
