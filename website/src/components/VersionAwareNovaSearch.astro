---
/**
 * Nova-styled wrapper around starlight-versions' version-aware search control.
 *
 * The versions component applies the required Pagefind filter for the selected
 * documentation major. Its original button styling is from Starlight's default
 * theme, so this wrapper provides Nova's compact mobile icon and full desktop
 * input appearance while retaining the version-specific search behavior.
 */
import VersionSearch from 'starlight-versions/components/VersionSearch.astro';
---

<VersionSearch class="nova-version-search" />

<style>
  /*
   * VersionSearch forwards this class to its `site-search` custom element. The
   * selectors intentionally target its internal button because the component
   * exposes no prop for button classes and must retain its version filter logic.
   */
  :global(site-search.nova-version-search button[data-open-modal]) {
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    height: 2rem;
    padding: 0.5rem;
    transition: background-color 150ms ease, transform 150ms ease;
    width: 2rem;
  }

  :global(site-search.nova-version-search button[data-open-modal]:hover) {
    background-color: rgb(156 163 175 / 0.3);
  }

  :global(site-search.nova-version-search button[data-open-modal]:active) {
    transform: scale(0.9);
  }

  @media (min-width: 48rem) {
    :global(site-search.nova-version-search button[data-open-modal]) {
      background-color: transparent;
      border: 1px solid var(--sl-color-gray-5);
      color: var(--sl-color-text);
      font-size: var(--sl-text-sm);
      height: 2.25rem;
      max-width: 22rem;
      padding: 0.5rem;
      transition: background-color 150ms ease, color 150ms ease;
      width: 100%;
    }

    :global(site-search.nova-version-search button[data-open-modal]:hover) {
      background-color: rgb(156 163 175 / 0.1);
      border-color: var(--sl-color-gray-5);
      color: var(--sl-color-text);
    }
  }
</style>
